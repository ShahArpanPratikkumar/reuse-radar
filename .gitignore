# dependencies
node_modules/
server/node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug & temporary files
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
.tmp*
.tmp-dev.log
scratch_commits.py
scratch_commits.js

# macOS
.DS_Store
*.pem

# Environment files & secrets (CRITICAL FOR SECURITY)
.env
.env.local
.env.development
.env.production
.env*.local
!.env.example
server/.env
server/.env.local
server/.env.development
server/.env.production
server/.env*.local
!server/.env.example

# Uploaded student media (keep folder structure via .gitkeep)
server/uploads/*
!server/uploads/.gitkeep
server/uploads/avatars/*
!server/uploads/avatars/.gitkeep

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
