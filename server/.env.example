# =============================================================================
# REUSE RADAR BACKEND - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Rename this file to .env and configure your production credentials
# =============================================================================

# Server HTTP Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/reuseradar?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/reuseradar?retryWrites=true&w=majority

# JWT Authentication Secret Key & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Base URL for static file serving and public links
BASE_URL=http://localhost:5000

