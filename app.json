{
  "expo": {
    "name": "ReUseRadar",
    "slug": "ReUseRadar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reuseradar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ReUse Radar needs camera access to photograph reusable items.",
        "NSLocationWhenInUseUsageDescription": "ReUse Radar needs location to show nearby items and tag pickup spots.",
        "NSContactsUsageDescription": "ReUse Radar needs contacts access to invite campus classmates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#064E3B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "package": "com.arpanshah23.ReUseRadar",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyReUseRadarCampusMarketplaceKey2026"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0FDF4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 130
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ReUse Radar needs camera access to photograph reusable items."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ReUse Radar needs location to show nearby items and tag pickup spots."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "ReUse Radar needs contacts access to invite campus classmates."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ReUse Radar needs photo access to attach pictures to your reusable items.",
          "cameraPermission": "ReUse Radar needs camera access to photograph reusable items."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#059669"
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyReUseRadarCampusMarketplaceKey2026"
        }
      ],
      "./plugins/withDisableMinify.js",
      "./plugins/withAndroidQueries.js",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "d36e1294-55e6-4a11-a855-360ab8de161c"
      }
    }
  }
}
